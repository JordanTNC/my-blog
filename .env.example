# Copy this file to .env (or just run `npm run create-admin`, which writes
# .env for you automatically).

# Shown as the default site name until you change it from /admin.
SITE_NAME=My Blog

# Admin login. Don't hand-edit ADMIN_PASSWORD_HASH -- run `npm run create-admin`
# instead, which hashes your password for you.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Long random string used to sign login sessions. `npm run create-admin`
# fills this in for you automatically.
SESSION_SECRET=

# Port the server listens on. Most hosts (Render, Railway, etc.) set this
# for you automatically and you can leave it as-is.
PORT=3000

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="page-content">
    <% if (pinned.length > 0) { %>
      <section class="section">
        <h1 class="section-title">Pinned Articles</h1>
        <div class="section-title-rule"></div>

        <ul class="article-list">
          <% pinned.forEach(function (post) { %>
            <li class="article-row">
              <a class="article-row-title" href="/post/<%= post.slug %>"><%= post.title %></a>
              <span class="article-row-date"><%= formatDateTime(post.created_at) %></span>
            </li>
          <% }) %>
        </ul>

        <% if (pinnedHasMore) { %>
          <div class="more-wrap">
            <a class="btn btn-secondary" href="/pinned">More</a>
          </div>
        <% } %>
      </section>
    <% } %>

    <section class="section">
      <h2 class="section-title">Recent Articles</h2>
      <div class="section-title-rule"></div>

      <% if (recent.length === 0) { %>
        <p class="empty-state">No articles yet.</p>
      <% } else { %>
        <ul class="article-list">
          <% recent.forEach(function (post) { %>
            <li class="article-row">
              <a class="article-row-title" href="/post/<%= post.slug %>"><%= post.title %></a>
              <span class="article-row-date"><%= formatDateTime(post.created_at) %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <% if (hasMore) { %>
        <div class="more-wrap">
          <a class="btn btn-secondary" href="/articles">More</a>
        </div>
      <% } %>
    </section>

    <section class="section">
      <h2 class="section-title">Articles by Topic</h2>
      <div class="section-title-rule"></div>
      <% if (allTags.length === 0) { %>
        <p class="empty-state">No categories yet.</p>
      <% } else { %>
        <div class="tag-grid">
          <% allTags.forEach(function (tag) { %>
            <a class="tag-button tag-color-<%= tag.id % 7 %>" href="/category/<%= tag.slug %>"><%= tag.name %></a>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
